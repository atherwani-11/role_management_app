# Replace these values with your Railway MySQL connection details for production.
# You can either set a full database URL or use individual settings.

# Option 1: use the Rails public URL from Railway
# DATABASE_URL=mysql://root:password@hostname:port/database

# Option 2: use individual values
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=role_management_app

# Render provides PORT automatically in production, but you can override it locally.
PORT=8081
